package com.tca;

class A{
	//this is example of method overloading...
	public void display() {
		System.out.println(" i am the real display");
	}
	public void display(int i) {
		System.out.println("i am the real display here's the proof I : "+i);
		
	}
}

public class demo1 {

	public static void main(String[] args) {
		A ob = new A();
		ob.display();
		ob.display(34);
	
      }
}
