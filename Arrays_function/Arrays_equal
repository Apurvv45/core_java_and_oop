package com.javadsapractice;
import java.util.Arrays;

public class arrfun {
    public static void main(String[] args ){
        int a[]={1,2,3,4,5,6};
        int b[]={1,2,3,4,5,6};

        if (Arrays.equals(a,b)){
            System.out.println("Arrays are equal");
        }
        else{
            System.out.println("Arrays are not equal");
        }
    }
}
