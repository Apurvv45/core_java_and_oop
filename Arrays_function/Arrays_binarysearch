package com.javadsapractice;
import java.util.Arrays;

public class arrfun {
    public static void main(String[] args ){
        int a[]={6,4,7,2,8,1};
        Arrays.sort(a);
        System.out.println("Sorted array : "+Arrays.toString(a));
        int index = Arrays.binarySearch(a,1);
        System.out.println("Result "+index);

    }
}
