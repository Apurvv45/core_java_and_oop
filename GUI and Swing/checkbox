import java.awt.*;
import java.awt.event.*;
import javax.swing.*;


public class Checkbox extends JFrame implements ActionListener{
	JCheckBox j1,j2,j3;
	JTextField tf;
	JButton b1;
	
	Checkbox(){
		setLayout(null);
		setTitle("Check Box");
		setSize(500,200);
		setVisible(true);
		
		j1=new JCheckBox("Music");
		j1.setSize(100,30);
		j1.setLocation(30,30);
		add(j1);
		
		j2=new JCheckBox("Sport");
		j2.setSize(100,30);
		j2.setLocation(30,60);
		add(j2);
		
		j3=new JCheckBox("Dance");
		j3.setSize(100,30);
		j3.setLocation(30,90);
		add(j3);
		
		tf=new JTextField();
		tf.setSize(200,30);
		tf.setLocation(150,60);
		add(tf);
		
		b1=new JButton("OK");
		b1.setSize(100,30);
		b1.setLocation(180,120);
		b1.addActionListener(this);
		add(b1);
		
	}
	
	

	public static void main(String[] args) {
		
		Checkbox c=new Checkbox();

	}

	@Override
	public void actionPerformed(ActionEvent e) {
		String S=e.getActionCommand();
		
		if(S.equals("OK")) {
			
			
			String msg="";
			if(j1.isSelected()) {
				msg=msg+j1.getText()+" ";
			}
			
			if(j2.isSelected()) {
				msg=msg+j2.getText()+" ";
			}
			
			if(j3.isSelected()) {
				msg=msg+j3.getText()+" ";
			}
			tf.setText(msg);
			
			
		}
		
	}

}
