import javax.swing.*;
import java.awt.*;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;

public class Firstscreen extends JFrame implements ActionListener{
	
	JLabel l;
	JTextField tf;
	JButton b1,b2;
	

	Firstscreen(){
		
		setLayout(null);
		
		l=new JLabel("Message :");
		l.setSize(100,20);
		l.setLocation(50,30);
		add(l);
		
		
		tf=new JTextField();
		tf.setSize(200,30);
		tf.setLocation(150,30);
		add(tf);
		
		b1=new JButton("Show");
		b1.setSize(100,30);
		b1.setLocation(90,80);
		b1.addActionListener(this);
		add(b1);
		
		b2=new JButton("Clear");
		b2.setSize(100,30);
		b2.setLocation(200,80);
		b2.addActionListener(this);
		add(b2);
		
		setTitle("TCA");
		setSize(450,450);
		setLocation(100,200);
		setVisible(true);
		setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
	}
	
	
	

	public static void main(String[] args) {
		Firstscreen fc=new Firstscreen();
		

	}

	public void actionPerformed(ActionEvent e) {
		String S=e.getActionCommand();
		
		if(S.equals("Show")) {
			System.out.println("Welcome to TCA");
		}
		
		if(S.equals("Clear")) {
			System.out.println("Welcome to India");
		}
		
	}


	

}
