package com.tca;



class A{
	//this is example of method overriding...
	public void display() {
		System.out.println(" i am in the A's display");
	}
	
}
class B extends A{
	public void display() {
		super.display();
		System.out.println("i am in the B's display");
	}
}

public class demo1 {

	public static void main(String[] args) {
		B ob = new B();
		ob.display();
		
	
      }
}
